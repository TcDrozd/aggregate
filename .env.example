# Copy to .env and fill in. Never commit .env.

# Where the ledger lives. The Docker image defaults to sqlite:////data/aggregate.db.
AGGREGATE_DATABASE_URL=sqlite:///data/aggregate.db

# docker compose only: host address and port to publish on, and the uid:gid the
# container runs as (must be able to write ./data).
AGGREGATE_BIND=127.0.0.1
AGGREGATE_PORT=8000
AGGREGATE_UID=1000
AGGREGATE_GID=1000
